# =============================================================================
# Universal King Environment Configuration
# CRM, Autonomous AI Lead Generation, Client Portal & Payments
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/universal_king
DATABASE_POOL_MAX=10
HEXAWAVE_DATABASE_SCHEMA=./infrastructure/database/schema.sql

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Required in production - at least 32 characters
HEXAWAVE_AUTH_SECRET=your-strong-secret-key-at-least-32-characters

# Admin credentials (required for first run)
HEXAWAVE_ADMIN_EMAIL=admin@universalking.com
HEXAWAVE_ADMIN_PASSWORD=your-strong-admin-password-min-12-chars

# Optional: Path to session secret file (used if HEXAWAVE_AUTH_SECRET not set)
HEXAWAVE_AUTH_SECRET_FILE=data/session.key

# JWT Secret for API tokens
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# Session lifetime in seconds (default: 604800 = 7 days)
SESSION_LIFETIME_SECONDS=604800

# -----------------------------------------------------------------------------
# AI Service Configuration
# -----------------------------------------------------------------------------
HEXAWAVE_AI_URL=http://127.0.0.1:8000
HEXAWAVE_AI_SERVICE_TOKEN=your-ai-service-token

# -----------------------------------------------------------------------------
# Tavily Search API (for AI-powered lead discovery)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key

# -----------------------------------------------------------------------------
# Lead Discovery Configuration
# -----------------------------------------------------------------------------
# Enable/disable daily discovery (true/false)
HEXAWAVE_DISCOVERY_DAILY_ENABLED=false

# Daily lead limit
DAILY_LEAD_LIMIT=100

# Target industries (comma-separated)
DISCOVERY_INDUSTRIES=software,technology,healthcare,manufacturing,finance,education,ecommerce,logistics

# Target company size segments (comma-separated: small,medium,large)
DISCOVERY_SIZE_SEGMENTS=small,medium,large

# Timezone for scheduled discovery
DISCOVERY_TIMEZONE=Asia/Kolkata

# Schedule cron expression (e.g., "0 2 * * *" for 2 AM daily)
DISCOVERY_SCHEDULE=0 2 * * *

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# -----------------------------------------------------------------------------

# Razorpay API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook Configuration
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_signature_verification
RAZORPAY_WEBHOOK_URL=http://yourdomain.com/api/payments/webhook

# Test mode (true/false) - Set to false for production
RAZORPAY_TEST_MODE=true

# Default currency
RAZORPAY_DEFAULT_CURRENCY=INR

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
# SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password-or-app-password

# Email From Address
EMAIL_FROM=Universal King <noreply@universalking.com>
EMAIL_FROM_NAME=Universal King

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API URL for frontend to connect to backend
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Base URL for the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# User & Project Storage
# -----------------------------------------------------------------------------
# Path to user data store (for legacy import)
HEXAWAVE_USER_STORE=data/users.json

# Path to project owner store
HEXAWAVE_PROJECT_OWNER_STORE=data/project-owners.json

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Upload directory
UPLOAD_DIR=./uploads

# Allowed file types
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.pdf,.doc,.docx,.txt,.zip

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Maximum requests per window
RATE_LIMIT_MAX=100

# Rate limit window in minutes
RATE_LIMIT_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Deployment Configuration (Render/Other Platforms)
# -----------------------------------------------------------------------------
# For Render.com deployment
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Database connection string for Render
# RENDER_DATABASE_URL=postgresql://user:password@host:port/database

# -----------------------------------------------------------------------------
# Security Headers
# -----------------------------------------------------------------------------
# Content Security Policy
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching/sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Application Specific Settings
# -----------------------------------------------------------------------------
# Enable automatic database migrations
AUTO_MIGRATE=true

# Enable detailed error messages in development
DETAILED_ERRORS=true

# -----------------------------------------------------------------------------
# King Account Configuration
# -----------------------------------------------------------------------------
# King/Super Admin email (for special administrative access)
KING_EMAIL=king@universalking.com

# King account password
KING_PASSWORD=your-king-account-password

# =============================================================================
# Notes:
# 1. All passwords, keys, and secrets should be at least 12-16 characters in production
# 2. Never commit real credentials to version control
# 3. Use environment-specific configuration for development, staging, production
# 4. For production, set NODE_ENV=production and use HTTPS
# 5. Database migrations run automatically on startup if AUTO_MIGRATE=true
# =============================================================================
