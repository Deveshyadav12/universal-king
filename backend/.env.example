# Copy to .env and replace these values. Do not commit backend/.env.
HEXAWAVE_AUTH_SECRET=
# Set this to the same private value as ai\.env. Never commit the real value.
HEXAWAVE_AI_SERVICE_TOKEN=
HEXAWAVE_ADMIN_EMAIL=
HEXAWAVE_ADMIN_PASSWORD=

# Required to enable Google lead discovery in the admin CRM.
SERPAPI_API_KEY=

# Local single-instance persistence; configure durable shared storage for production.
HEXAWAVE_USER_STORE=data/users.json
HEXAWAVE_PROJECT_OWNER_STORE=data/project-owners.json
HEXAWAVE_KING_REQUEST_STORE=data/king-requests.json
HEXAWAVE_TRADING_FEATURE_STORE=data/trading-feature.json
HEXAWAVE_AUTH_SECRET_FILE=data/session.key

# Razorpay credentials are server-side only. Use test credentials for validation.
# Replace any credential previously pasted into chat and keep the replacement local.
HEXAWAVE_RAZORPAY_KEY_ID=
HEXAWAVE_RAZORPAY_KEY_SECRET=
HEXAWAVE_RAZORPAY_WEBHOOK_SECRET=
# Live charges stay disabled unless explicitly enabled after approval.
HEXAWAVE_RAZORPAY_LIVE_ENABLED=false
HEXAWAVE_BILLING_STORE=data/billing.json
