# AI Service Configuration
HEXAWAVE_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b
# Set the same random, private value in backend\.env; production also requires
# HEXAWAVE_ENV=production (or NODE_ENV=production).
HEXAWAVE_AI_SERVICE_TOKEN=
# Optional model override. Defaults to OLLAMA_MODEL for Ollama.
# HEXAWAVE_MODEL=

# PostgreSQL Database Configuration for AI Projects
DATABASE_URL=postgresql://user:password@localhost:5432/hexawave_ai

# Service URLs
HEXAWAVE_AI_URL=http://localhost:8000

# Auto Discovery Settings
AUTO_DISCOVERY_ENABLED=true

# To use OpenAI instead, set HEXAWAVE_LLM_PROVIDER=openai and provide:
# OPENAI_API_KEY=

# Azure OpenAI Configuration (optional)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=

# Tavily Search Configuration (optional)
# TAVILY_API_KEY=

# AI Offline Mode (set to true for testing without AI)
AI_OFFLINE_MODE=false

# AI Authentication
AI_REQUIRE_AUTH=false
